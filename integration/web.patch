+    assert.equal(create.status, 201);
+    const sanitized = await create.json();
+    assert.equal(sanitized.hash, undefined);
+    assert.equal(sanitized.password, undefined);
+    await call(
+      "/admin/workers",
+      "POST",
+      {
+        email: "otro@test.invalid",
+        password: "worker-password-123",
+        name: "Otro",
+        role: "instalacion",
+      },
+      admin,
+    );
+    const worker = await login("medidor@test.invalid", "worker-password-123");
+    const other = await login("otro@test.invalid", "worker-password-123");
+    for (const p of [
+      "/admin/settings",
+      "/admin/clients",
+      "/admin/workers",
+      "/admin/visits",
+    ])
+      assert.equal((await call(p, "GET", null, worker)).status, 403);
+    assert.equal((await call("/mobile/visits")).status, 401);
+    const v = {
+      id: randomUUID(),
+      client: "Cliente prueba",
+      phone: "999111222",
+      location: "Lima",
+      project: "Baño",
+      materialId: "m",
