+    assert.equal((await call("/mobile/visits", "POST", v, other)).status, 403);
+    assert.equal((await call("/mobile/visits", "POST", v, worker)).status, 201);
+    assert.equal((await call("/mobile/visits", "POST", v, worker)).status, 201);
+    assert.equal((await db.list("visits")).length, 1);
+    assert.equal((await db.list("quotes")).length, 1);
+    assert.equal((await db.list("clients")).length, 1);
+    assert.deepEqual(
+      await (await call("/mobile/visits", "GET", null, other)).json(),
+      [],
+    );
+    assert.equal(
+      (await call(`/mobile/visits/${v.id}/image`, "POST", null, other)).status,
+      403,
+    );
+    assert.equal(
+      (
+        await call(
+          "/admin/visits/" + v.id,
+          "PATCH",
+          { status: "Validada" },
+          admin,
+        )
+      ).status,
+      200,
+    );
+    const changed = await call(
+      "/admin/workers/medidor%40test.invalid",
+      "PATCH",
+      { name: "Operador de medición" },
+      admin,
+    );
+    assert.equal(changed.status, 200);
+    assert.equal((await changed.json()).name, "Operador de medición");
+    assert.equal(
+      (await (await call("/mobile/me", "GET", null, worker)).json()).name,
+      "Operador de medición",
+    );
+    assert.equal(
+      (
+        await call(
+          "/admin/workers/medidor%40test.invalid",
+          "PATCH",
+          { name: "Intruso" },
+          worker,
+        )
+      ).status,
+      403,
+    );
+    assert.equal(
+      (
+        await call(
+          "/admin/workers/medidor%40test.invalid",
+          "PATCH",
+          { name: "" },
+          admin,
+        )
+      ).status,
+      400,
+    );
+    const reset = await call(
+      "/admin/workers/medidor%40test.invalid",
+      "PATCH",
+      { password: "new-worker-password-456" },
+      admin,
+    );
+    assert.equal(reset.status, 200);
+    assert.equal((await reset.json()).hash, undefined);
+    assert.equal((await call("/mobile/me", "GET", null, worker)).status, 401);
+    assert.equal(
+      (
+        await call("/auth/login", "POST", {
+          email: "medidor@test.invalid",
+          password: "worker-password-123",
+        })
+      ).status,
+      401,
+    );
+    const renewed = await login(
+      "medidor@test.invalid",
+      "new-worker-password-456",
+    );
+    await call(
+      "/admin/workers/medidor%40test.invalid",
+      "PATCH",
+      { disabled: true },
+      admin,
+    );
+    assert.equal((await call("/mobile/me", "GET", null, worker)).status, 401);
+    assert.equal((await call("/mobile/me", "GET", null, renewed)).status, 401);
+    await call(
+      "/admin/workers/medidor%40test.invalid",
+      "PATCH",
+      { disabled: false, role: "cotizacion" },
