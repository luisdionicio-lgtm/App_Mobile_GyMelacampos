diff --git a/backend/test/mobile.test.js b/backend/test/mobile.test.js
new file mode 100644
index 0000000..7f96f96
--- /dev/null
+++ b/backend/test/mobile.test.js
@@ -0,0 +1,240 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { createDatabase } from "../src/infrastructure/database.js";
+import { createService } from "../src/application/service.js";
+import { initializeAuth } from "../src/infrastructure/auth.js";
+import { createApp } from "../src/presentation/app.js";
+import { quantities, visitInput } from "../src/domain/mobile-visit.js";
+test("piezas conservan área, largo y cantidades sin conversión de unidades", () => {
+  assert.deepEqual(
+    quantities([
+      { length: 1.2, width: 0.55, quantity: 2 },
+      { length: 0.8, width: 0.1, quantity: 1 },
+    ]),
+    { area: 1.4, linear: 3.2 },
+  );
+  assert.equal(
+    visitInput.safeParse({
+      id: randomUUID(),
+      client: "Cliente",
+      phone: "999111222",
+      location: "Lima",
+      project: "Baño",
+      materialId: "m",
+      unit: "m²",
+      pieces: [{ label: "Encimera", length: -1, width: 1, quantity: 1 }],
+    }).success,
