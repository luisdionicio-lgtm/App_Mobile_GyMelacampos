diff --git a/backend/src/application/mobile-service.js b/backend/src/application/mobile-service.js
new file mode 100644
index 0000000..372e19c
--- /dev/null
+++ b/backend/src/application/mobile-service.js
@@ -0,0 +1,40 @@
+import { AppError } from "../domain/schemas.js";
+export async function submitFieldQuote(db, service, data, worker) {
+  const existing = await db.get("visits", data.id);
+  if (existing && existing.worker !== worker)
+    throw new AppError("Identificador no disponible", 409);
+  if (existing) return { quoteId: existing.quoteId, preview: existing.preview };
+  const quantity = data.unit === "ML" ? data.totals.linear : data.totals.area;
+  if (quantity < 0.01 || quantity > 100000)
+    throw new AppError("La cantidad cotizada debe estar entre 0.01 y 100000");
+  const quote = await service.submitQuote(
+    {
+      nombre: data.client,
+      apellido: "",
+      email: "",
+      tel: data.phone,
+      distrito: data.location,
+      tipo: data.project,
+      material: data.material.name,
+      unit: data.unit,
+      quantity,
+      area: data.totals.area,
+      desc: (
+        data.notes +
+        "\nVisita móvil " +
+        data.id +
+        "\n" +
+        data.pieces
+          .map(
+            (p) =>
+              `${p.label}: ${p.length} x ${p.width} m, espesor ${p.thickness} cm, cantidad ${p.quantity}`,
+          )
+          .join("\n")
+      ).slice(0, 3000),
+    },
+    "mobile-" + data.id,
+    [],
+    true,
+  );
+  return { quoteId: quote.id, preview: quote.assistantPreview };
+}
diff --git a/backend/src/domain/mobile-visit.js b/backend/src/domain/mobile-visit.js
new file mode 100644
index 0000000..284f427
--- /dev/null
+++ b/backend/src/domain/mobile-visit.js
@@ -0,0 +1,34 @@
+import { z } from "zod";
+const piece = z.object({
+  label: z.string().trim().min(1).max(100),
+  length: z.number().min(0.01).max(100),
+  width: z.number().min(0.01).max(100),
+  quantity: z.number().int().min(1).max(100),
+  thickness: z.number().min(0.1).max(30).default(2),
+});
+export const visitInput = z.object({
+  id: z.uuid(),
+  client: z.string().trim().min(2).max(200),
+  phone: z
+    .string()
+    .regex(/^\+?[\d ()-]{7,30}$/)
+    .refine((v) => v.replace(/\D/g, "").length >= 7, "Teléfono inválido"),
+  location: z.string().trim().min(2).max(300),
+  project: z.enum(["Baño", "Cocina", "Otro"]),
+  materialId: z.string().min(1).max(200),
+  unit: z.enum(["ML", "m²"]),
+  pieces: z.array(piece).min(1).max(30),
+  notes: z.string().max(3000).default(""),
+});
+export function quantities(pieces) {
+  return {
+    area:
+      Math.round(
+        pieces.reduce((s, p) => s + p.length * p.width * p.quantity, 0) * 10000,
+      ) / 10000,
+    linear:
+      Math.round(
+        pieces.reduce((s, p) => s + p.length * p.quantity, 0) * 10000,
+      ) / 10000,
+  };
+}
